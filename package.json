{
  "name": "projecttools",
  "version": "0.2.0",
  "description": "A powerful CLI tool for managing development projects across multiple workspaces and profiles",
  "bin": {
    "pt": "./bin/pt"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "prepare": "husky install",
    "clean": "rimraf dist"
  },
  "keywords": [
    "cli",
    "project-management",
    "workspace",
    "profile",
    "development-tools",
    "typescript",
    "node"
  ],
  "author": "Bradley Deans <developer@deansbrad.com>",
  "license": "MIT",
  "homepage": "https://github.com/deans-bradley/project-tools#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deans-bradley/project-tools.git"
  },
  "bugs": {
    "url": "https://github.com/deans-bradley/project-tools/issues"
  },
  "engines": {
    "node": ">=25.2.1"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "chalk": "^5.4.1",
    "inquirer": "^9.2.15",
    "fs-extra": "^11.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "@types/fs-extra": "^11.0.4",
    "@types/uuid": "^9.0.8",
    "@types/inquirer": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}